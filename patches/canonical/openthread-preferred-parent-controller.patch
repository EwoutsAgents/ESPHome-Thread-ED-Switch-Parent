+
+typedef enum otThreadPreferredParentMode
+{
+    OT_THREAD_PREFERRED_PARENT_MODE_MULTICAST = 0,
+    OT_THREAD_PREFERRED_PARENT_MODE_UNICAST   = 1,
+} otThreadPreferredParentMode;
+
+typedef enum otThreadPreferredParentState
+{
+    OT_THREAD_PREFERRED_PARENT_STATE_IDLE = 0,
+    OT_THREAD_PREFERRED_PARENT_STATE_STARTING_DISCOVERY,
+    OT_THREAD_PREFERRED_PARENT_STATE_WAITING_PARENT_REQUEST,
+    OT_THREAD_PREFERRED_PARENT_STATE_WAITING_TARGET_RESPONSE,
+    OT_THREAD_PREFERRED_PARENT_STATE_CONTINUING_SELECTED_ATTACH,
+    OT_THREAD_PREFERRED_PARENT_STATE_WAITING_CHILD_ID_RESPONSE,
+    OT_THREAD_PREFERRED_PARENT_STATE_SUCCEEDED,
+    OT_THREAD_PREFERRED_PARENT_STATE_FAILED,
+    OT_THREAD_PREFERRED_PARENT_STATE_TIMED_OUT,
+    OT_THREAD_PREFERRED_PARENT_STATE_CANCELLED,
+} otThreadPreferredParentState;
+
+typedef enum otThreadPreferredParentResult
+{
+    OT_THREAD_PREFERRED_PARENT_RESULT_NONE = 0,
+    OT_THREAD_PREFERRED_PARENT_RESULT_SUCCESS,
+    OT_THREAD_PREFERRED_PARENT_RESULT_START_FAILED,
+    OT_THREAD_PREFERRED_PARENT_RESULT_TARGET_TIMEOUT,
+    OT_THREAD_PREFERRED_PARENT_RESULT_ATTACH_TIMEOUT,
+    OT_THREAD_PREFERRED_PARENT_RESULT_ROLE_CHANGED,
+    OT_THREAD_PREFERRED_PARENT_RESULT_CANCELLED,
+} otThreadPreferredParentResult;
+
+typedef enum otThreadPreferredParentEvent
+{
+    OT_THREAD_PREFERRED_PARENT_EVENT_REQUESTED = 0,
+    OT_THREAD_PREFERRED_PARENT_EVENT_PARENT_REQUEST_STARTED,
+    OT_THREAD_PREFERRED_PARENT_EVENT_TARGET_RESPONSE,
+    OT_THREAD_PREFERRED_PARENT_EVENT_CHILD_ID_REQUEST_STARTED,
+    OT_THREAD_PREFERRED_PARENT_EVENT_SUCCEEDED,
+    OT_THREAD_PREFERRED_PARENT_EVENT_FAILED,
+    OT_THREAD_PREFERRED_PARENT_EVENT_TIMED_OUT,
+    OT_THREAD_PREFERRED_PARENT_EVENT_CANCELLED,
+    OT_THREAD_PREFERRED_PARENT_EVENT_CLEARED,
+} otThreadPreferredParentEvent;
+
+typedef struct otThreadPreferredParentConfig
+{
+    otExtAddress                 mExtAddress;
+    otThreadPreferredParentMode mMode;
+    uint8_t                      mMaxAttempts;
+    uint32_t                     mRetryInterval; ///< Parent Response wait/retry interval in milliseconds.
+    uint32_t                     mAttachTimeout; ///< Child ID Response timeout in milliseconds.
+} otThreadPreferredParentConfig;
+
+typedef struct otThreadPreferredParentStatus
+{
+    otThreadPreferredParentState  mState;
+    otThreadPreferredParentResult mResult;
+    otThreadPreferredParentMode   mMode;
+    otExtAddress                  mExtAddress;
+    uint32_t                      mGeneration;
+    uint8_t                       mAttempt;
+    uint8_t                       mMaxAttempts;
+    otError                       mError;
+} otThreadPreferredParentStatus;
+
+typedef struct otThreadPreferredParentEventInfo
+{
+    otThreadPreferredParentEvent  mEvent;
+    otThreadPreferredParentStatus mStatus;
+    uint16_t                       mParentRloc16;
+    int8_t                         mParentRssi;
+} otThreadPreferredParentEventInfo;
+
+typedef void (*otThreadPreferredParentCallback)(const otThreadPreferredParentEventInfo *aEventInfo, void *aContext);
+
+/**
+ * Registers a synchronous, observational state/event callback.
+ *
+ * The callback runs from OpenThread processing context. It must not call a
+ * preferred-parent mutating API. Registering `NULL` removes the callback.
+ */
+otError otThreadPreferredParentSetCallback(otInstance                      *aInstance,
+                                            otThreadPreferredParentCallback aCallback,
+                                            void                            *aContext);
+
+/**
+ * Starts a switch from an attached child role.
+ *
+ * Returns `OT_ERROR_BUSY` when an attach or switch is already active,
+ * `OT_ERROR_INVALID_STATE` unless the device is a child, and
+ * `OT_ERROR_INVALID_ARGS` for invalid modes, timeouts, attempts, or all-zero/
+ * all-ones targets. Extended-address bytes use normal `otExtAddress` order.
+ */
+otError otThreadPreferredParentStart(otInstance *aInstance, const otThreadPreferredParentConfig *aConfig);
+
+/** Cancels an active operation while preserving the existing attachment. */
+otError otThreadPreferredParentCancel(otInstance *aInstance);
+
+/** Clears retained terminal status. Returns `OT_ERROR_BUSY` while active. */
+otError otThreadPreferredParentClear(otInstance *aInstance);
+
+/** Copies the current operation status. Terminal state persists until start or clear. */
+void    otThreadPreferredParentGetStatus(otInstance *aInstance, otThreadPreferredParentStatus *aStatus);
+
+#ifdef __cplusplus
+} // extern "C"
+#endif
+
+#endif // OPENTHREAD_PREFERRED_PARENT_H_
