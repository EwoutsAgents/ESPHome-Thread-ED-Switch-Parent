+#if OPENTHREAD_CONFIG_EXPERIMENTAL_PREFERRED_PARENT_ENABLE
+bool Mle::Attacher::IsPreferredParentActive(void) const
+{
+    return (mPreferredParentStatus.mState >= OT_THREAD_PREFERRED_PARENT_STATE_STARTING_DISCOVERY) &&
+           (mPreferredParentStatus.mState <= OT_THREAD_PREFERRED_PARENT_STATE_WAITING_CHILD_ID_RESPONSE);
+}
+
+void Mle::Attacher::GetPreferredParentStatus(otThreadPreferredParentStatus &aStatus) const
+{
+    aStatus = mPreferredParentStatus;
+}
+
+void Mle::Attacher::SetPreferredParentCallback(otThreadPreferredParentCallback aCallback, void *aContext)
+{
+    mPreferredParentCallback        = aCallback;
+    mPreferredParentCallbackContext = aContext;
+}
+
+void Mle::Attacher::EmitPreferredParentEvent(otThreadPreferredParentEvent aEvent, uint16_t aRloc16, int8_t aRssi)
+{
+    otThreadPreferredParentEventInfo eventInfo;
+
+    VerifyOrExit(mPreferredParentCallback != nullptr);
+    ClearAllBytes(eventInfo);
+    eventInfo.mEvent        = aEvent;
+    eventInfo.mStatus       = mPreferredParentStatus;
+    eventInfo.mParentRloc16 = aRloc16;
+    eventInfo.mParentRssi   = aRssi;
+    mPreferredParentCallback(&eventInfo, mPreferredParentCallbackContext);
+
+exit:
+    return;
+}
+
+void Mle::Attacher::RestorePreferredParentRxState(void)
+{
+    if (mPreferredParentForcedRxOn && !mPreferredParentWasRxOn)
+    {
+        Get<MeshForwarder>().SetRxOnWhenIdle(false);
+    }
+
+    mPreferredParentForcedRxOn = false;
+    mPreferredParentWasRxOn    = false;
+}
+
+void Mle::Attacher::FinishPreferredParent(otThreadPreferredParentState  aState,
+                                           otThreadPreferredParentResult aResult,
+                                           Error                         aError,
+                                           otThreadPreferredParentEvent  aEvent)
+{
+    mTimer.Stop();
+    SetState(kStateIdle);
+    RestorePreferredParentRxState();
+    mParentCandidate.Clear();
+    mPreferredParentCandidate.Clear();
+    mPreferredParentCandidateValid = false;
+    mPreferredParentStatus.mState  = aState;
+    mPreferredParentStatus.mResult = aResult;
+    mPreferredParentStatus.mError  = aError;
+    EmitPreferredParentEvent(aEvent);
+}
+
+void Mle::Attacher::BeginPreferredParentAttempt(void)
+{
+    mPreferredParentStatus.mAttempt++;
+    mPreferredParentStatus.mState = OT_THREAD_PREFERRED_PARENT_STATE_STARTING_DISCOVERY;
+    mPreferredParentCandidate.Clear();
+    mPreferredParentCandidateValid = false;
+    mParentCandidate.Clear();
+    mPreferredParentWasRxOn    = Get<Mle>().IsRxOnWhenIdle();
+    mPreferredParentForcedRxOn = !mPreferredParentWasRxOn;
+    Attach(kBetterParent);
+    mPreferredParentStatus.mState = OT_THREAD_PREFERRED_PARENT_STATE_WAITING_PARENT_REQUEST;
+}
+
+Error Mle::Attacher::StartPreferredParent(const otThreadPreferredParentConfig &aConfig)
+{
+    Error error = kErrorNone;
+    bool  allZero = true;
+    bool  allOnes = true;
+
+    VerifyOrExit(Get<Mle>().IsChild(), error = kErrorInvalidState);
+    VerifyOrExit(!IsPreferredParentActive() && !IsAttaching(), error = kErrorBusy);
+    VerifyOrExit((aConfig.mMode == OT_THREAD_PREFERRED_PARENT_MODE_MULTICAST) ||
+                     (aConfig.mMode == OT_THREAD_PREFERRED_PARENT_MODE_UNICAST),
+                 error = kErrorInvalidArgs);
+    VerifyOrExit((aConfig.mMaxAttempts != 0) && (aConfig.mRetryInterval != 0) && (aConfig.mAttachTimeout != 0),
+                 error = kErrorInvalidArgs);
+
+    for (uint8_t byte : aConfig.mExtAddress.m8)
+    {
+        allZero = allZero && (byte == 0);
+        allOnes = allOnes && (byte == 0xff);
+    }
+    VerifyOrExit(!allZero && !allOnes, error = kErrorInvalidArgs);
+
+    mPreferredParentConfig = aConfig;
+    mPreferredParentStatus.mState       = OT_THREAD_PREFERRED_PARENT_STATE_STARTING_DISCOVERY;
+    mPreferredParentStatus.mResult      = OT_THREAD_PREFERRED_PARENT_RESULT_NONE;
+    mPreferredParentStatus.mMode        = aConfig.mMode;
+    mPreferredParentStatus.mExtAddress  = aConfig.mExtAddress;
+    mPreferredParentStatus.mGeneration++;
+    mPreferredParentStatus.mAttempt     = 0;
+    mPreferredParentStatus.mMaxAttempts = aConfig.mMaxAttempts;
+    mPreferredParentStatus.mError       = kErrorNone;
+    EmitPreferredParentEvent(OT_THREAD_PREFERRED_PARENT_EVENT_REQUESTED);
+    BeginPreferredParentAttempt();
+
+exit:
+    return error;
+}
+
+Error Mle::Attacher::CancelPreferredParent(void)
+{
+    Error error = kErrorNone;
+
+    VerifyOrExit(IsPreferredParentActive(), error = kErrorInvalidState);
+    FinishPreferredParent(OT_THREAD_PREFERRED_PARENT_STATE_CANCELLED,
+                          OT_THREAD_PREFERRED_PARENT_RESULT_CANCELLED, kErrorAbort,
+                          OT_THREAD_PREFERRED_PARENT_EVENT_CANCELLED);
+
+exit:
+    return error;
+}
+
+Error Mle::Attacher::ClearPreferredParent(void)
+{
+    Error error = kErrorNone;
+    uint32_t generation;
+
+    VerifyOrExit(!IsPreferredParentActive(), error = kErrorBusy);
+    generation = mPreferredParentStatus.mGeneration;
+    ClearAllBytes(mPreferredParentConfig);
+    mPreferredParentCandidate.Clear();
+    mPreferredParentCandidateValid = false;
+    ClearAllBytes(mPreferredParentStatus);
+    mPreferredParentStatus.mState  = OT_THREAD_PREFERRED_PARENT_STATE_IDLE;
+    mPreferredParentStatus.mResult = OT_THREAD_PREFERRED_PARENT_RESULT_NONE;
+    mPreferredParentStatus.mError  = kErrorNone;
+    mPreferredParentStatus.mGeneration = generation;
+    EmitPreferredParentEvent(OT_THREAD_PREFERRED_PARENT_EVENT_CLEARED);
+
+exit:
+    return error;
+}
+
+void Mle::Attacher::RetryOrTimeoutPreferredParent(otThreadPreferredParentResult aResult)
+{
+    SetState(kStateIdle);
+    mTimer.Stop();
+    RestorePreferredParentRxState();
+    mParentCandidate.Clear();
+    mPreferredParentCandidate.Clear();
+    mPreferredParentCandidateValid = false;
+
+    if (mPreferredParentStatus.mAttempt < mPreferredParentStatus.mMaxAttempts)
+    {
+        BeginPreferredParentAttempt();
+    }
+    else
+    {
+        FinishPreferredParent(OT_THREAD_PREFERRED_PARENT_STATE_TIMED_OUT, aResult, kErrorResponseTimeout,
+                              OT_THREAD_PREFERRED_PARENT_EVENT_TIMED_OUT);
+    }
 }
+#endif
 
