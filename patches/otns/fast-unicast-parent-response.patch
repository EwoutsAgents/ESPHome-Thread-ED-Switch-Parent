+/**
+ * @def OPENTHREAD_CONFIG_EXPERIMENTAL_UNICAST_PARENT_RESPONSE_FASTPATH_ENABLE
+ *
+ * Define as 1 for an FTD to send a Parent Response immediately after receiving
+ * an IPv6-unicast Parent Request. Multicast Parent Requests retain the normal
+ * randomized response delay.
+ *
+ * This option is experimental and disabled by default.
+ */
+#ifndef OPENTHREAD_CONFIG_EXPERIMENTAL_UNICAST_PARENT_RESPONSE_FASTPATH_ENABLE
+#define OPENTHREAD_CONFIG_EXPERIMENTAL_UNICAST_PARENT_RESPONSE_FASTPATH_ENABLE 0
+#endif
