diff --git a/examples/apps/cli/selected_parent_cli.cpp b/examples/apps/cli/selected_parent_cli.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..510de28541e45c959106c1ca5cf0b097d41e8af6
--- /dev/null
+++ b/examples/apps/cli/selected_parent_cli.cpp
@@ -0,0 +1,357 @@
+/*
+ * Copyright (c) 2026, The OpenThread Authors.
+ * All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "selected_parent_cli.h"
+
+#include <string.h>
+
+#include <openthread/cli.h>
+#include <openthread/platform/alarm-milli.h>
+#include <openthread/selected_parent.h>
+
+namespace {
+
+enum ControllerState : uint8_t
+{
+    kStateIdle,
+    kStateWaitingTargetResponse,
+    kStateWaitingChildIdResponse,
+    kStateSucceeded,
+    kStateFailed,
+};
+
+enum DiscoveryMode : uint8_t
+{
+    kModeMulticast,
+    kModeUnicast,
+};
+
+struct Controller
+{
+    otInstance     *mInstance;
+    otExtAddress    mTarget;
+    ControllerState mState;
+    DiscoveryMode   mMode;
+    uint32_t        mGeneration;
+    uint32_t        mStartedAt;
+    bool            mParentRequestPending;
+    bool            mTargetResponsePending;
+    uint16_t        mTargetRloc16;
+    int8_t          mTargetRssi;
+    bool            mAttacherStatePending;
+    uint8_t         mAttacherState;
+};
+
+Controller sController;
+
+constexpr uint32_t kOperationTimeout = 16000;
+
+bool IsSameExtAddress(const otExtAddress &aFirst, const otExtAddress &aSecond)
+{
+    return memcmp(aFirst.m8, aSecond.m8, sizeof(aFirst.m8)) == 0;
+}
+
+int HexDigit(char aChar)
+{
+    if ((aChar >= '0') && (aChar <= '9'))
+    {
+        return aChar - '0';
+    }
+    if ((aChar >= 'a') && (aChar <= 'f'))
+    {
+        return aChar - 'a' + 10;
+    }
+    if ((aChar >= 'A') && (aChar <= 'F'))
+    {
+        return aChar - 'A' + 10;
+    }
+    return -1;
+}
+
+otError ParseExtAddress(const char *aText, otExtAddress &aAddress)
+{
+    uint8_t byteIndex = 0;
+    int     highNibble = -1;
+
+    memset(&aAddress, 0, sizeof(aAddress));
+
+    for (const char *cur = aText; *cur != '\0'; cur++)
+    {
+        int value;
+
+        if ((*cur == ':') || (*cur == '-'))
+        {
+            continue;
+        }
+
+        value = HexDigit(*cur);
+        if (value < 0)
+        {
+            return OT_ERROR_INVALID_ARGS;
+        }
+
+        if (highNibble < 0)
+        {
+            highNibble = value;
+        }
+        else
+        {
+            if (byteIndex >= sizeof(aAddress.m8))
+            {
+                return OT_ERROR_INVALID_ARGS;
+            }
+            aAddress.m8[byteIndex++] = static_cast<uint8_t>((highNibble << 4) | value);
+            highNibble = -1;
+        }
+    }
+
+    return ((byteIndex == sizeof(aAddress.m8)) && (highNibble < 0)) ? OT_ERROR_NONE : OT_ERROR_INVALID_ARGS;
+}
+
+void OutputExtAddress(const otExtAddress &aAddress)
+{
+    for (uint8_t byte : aAddress.m8)
+    {
+        otCliOutputFormat("%02x", byte);
+    }
+}
+
+const char *StateToString(ControllerState aState)
+{
+    switch (aState)
+    {
+    case kStateIdle:
+        return "idle";
+    case kStateWaitingTargetResponse:
+        return "waiting_target_response";
+    case kStateWaitingChildIdResponse:
+        return "waiting_child_id_response";
+    case kStateSucceeded:
+        return "succeeded";
+    case kStateFailed:
+        return "failed";
+    }
+    return "unknown";
+}
+
+const char *ModeToString(DiscoveryMode aMode) { return (aMode == kModeUnicast) ? "unicast" : "multicast"; }
+
+void OutputTarget(void) { OutputExtAddress(sController.mTarget); }
+
+void ClearOperation(bool aEmitEvent)
+{
+    thread_preferred_parent_ot_clear(sController.mInstance);
+    sController.mState = kStateIdle;
+    sController.mParentRequestPending = false;
+    sController.mTargetResponsePending = false;
+    sController.mAttacherStatePending = false;
+
+    if (aEmitEvent)
+    {
+        otCliOutputFormat("PREFPARENT event=cleared\r\n");
+    }
+}
+
+void FailOperation(const char *aReason, otError aError)
+{
+    otCliOutputFormat("PREFPARENT event=failed generation=%lu reason=%s error=%s\r\n",
+                      static_cast<unsigned long>(sController.mGeneration), aReason, otThreadErrorToString(aError));
+    thread_preferred_parent_ot_clear(sController.mInstance);
+    sController.mState = kStateFailed;
+    sController.mParentRequestPending = false;
+    sController.mTargetResponsePending = false;
+    sController.mAttacherStatePending = false;
+}
+
+void HandleParentResponse(const otThreadParentResponseInfo *aInfo, void *)
+{
+    if ((aInfo != nullptr) && (sController.mState == kStateWaitingTargetResponse) &&
+        IsSameExtAddress(aInfo->mExtAddr, sController.mTarget))
+    {
+        sController.mTargetRloc16 = aInfo->mRloc16;
+        sController.mTargetRssi = aInfo->mRssi;
+        sController.mTargetResponsePending = true;
+    }
+}
+
+void HandleParentRequestStarted(void *) { sController.mParentRequestPending = true; }
+
+void HandleAttacherState(uint8_t aState, void *)
+{
+    sController.mAttacherState = aState;
+    sController.mAttacherStatePending = true;
+}
+
+otError StartSwitch(const char *aTarget, const char *aMode)
+{
+    otError error;
+
+    if ((sController.mState == kStateWaitingTargetResponse) ||
+        (sController.mState == kStateWaitingChildIdResponse))
+    {
+        return OT_ERROR_BUSY;
+    }
+
+    if (strcmp(aMode, "multicast") == 0)
+    {
+        sController.mMode = kModeMulticast;
+    }
+    else if (strcmp(aMode, "unicast") == 0)
+    {
+        sController.mMode = kModeUnicast;
+    }
+    else
+    {
+        return OT_ERROR_INVALID_ARGS;
+    }
+
+    error = ParseExtAddress(aTarget, sController.mTarget);
+    if (error != OT_ERROR_NONE)
+    {
+        return error;
+    }
+
+    thread_preferred_parent_ot_clear(sController.mInstance);
+    error = thread_preferred_parent_ot_set_discovery_target_extaddr(sController.mInstance, &sController.mTarget);
+    if (error != OT_ERROR_NONE)
+    {
+        return error;
+    }
+
+    sController.mState = kStateWaitingTargetResponse;
+    sController.mStartedAt = otPlatAlarmMilliGetNow();
+    sController.mParentRequestPending = false;
+    sController.mTargetResponsePending = false;
+    sController.mAttacherStatePending = false;
+
+    if (sController.mMode == kModeMulticast)
+    {
+        error = thread_preferred_parent_ot_start_parent_discovery(sController.mInstance);
+    }
+    else
+    {
+        error = thread_preferred_parent_ot_start_parent_discovery_unicast_now(sController.mInstance,
+                                                                               &sController.mTarget);
+    }
+
+    if (error != OT_ERROR_NONE)
+    {
+        ClearOperation(false);
+        return error;
+    }
+
+    sController.mGeneration = thread_preferred_parent_ot_get_generation(sController.mInstance);
+    otCliOutputFormat("PREFPARENT event=requested generation=%lu target=",
+                      static_cast<unsigned long>(sController.mGeneration));
+    OutputTarget();
+    otCliOutputFormat(" mode=%s\r\n", ModeToString(sController.mMode));
+    return OT_ERROR_NONE;
+}
+
+otError ProcessStatus(void)
+{
+    otCliOutputFormat("PREFPARENT event=status state=%s generation=%lu active=%d mode=%s target=",
+                      StateToString(sController.mState), static_cast<unsigned long>(sController.mGeneration),
+                      thread_preferred_parent_ot_is_active(sController.mInstance), ModeToString(sController.mMode));
+    OutputTarget();
+    otCliOutputFormat("\r\n");
+    return OT_ERROR_NONE;
+}
+
+} // namespace
+
+extern "C" void otSelectedParentCliInit(otInstance *aInstance)
+{
+    memset(&sController, 0, sizeof(sController));
+    sController.mInstance = aInstance;
+    sController.mState = kStateIdle;
+    sController.mMode = kModeMulticast;
+
+    thread_preferred_parent_ot_register_parent_response_callback(HandleParentResponse, nullptr);
+    thread_preferred_parent_ot_register_parent_req_started_callback(HandleParentRequestStarted, nullptr);
+    thread_preferred_parent_ot_register_attacher_state_callback(HandleAttacherState, nullptr);
+}
+
+extern "C" otError otSelectedParentCliCommand(void *, uint8_t aArgsLength, char *aArgs[])
+{
+    if ((aArgsLength == 1) && (strcmp(aArgs[0], "status") == 0))
+    {
+        return ProcessStatus();
+    }
+    if ((aArgsLength == 1) && (strcmp(aArgs[0], "clear") == 0))
+    {
+        ClearOperation(true);
+        return OT_ERROR_NONE;
+    }
+    if ((aArgsLength == 3) && (strcmp(aArgs[0], "switch") == 0))
+    {
+        return StartSwitch(aArgs[1], aArgs[2]);
+    }
+    return OT_ERROR_INVALID_ARGS;
+}
+
+extern "C" void otSelectedParentCliProcess(void)
+{
+    otRouterInfo parentInfo;
+
+    if (sController.mParentRequestPending)
+    {
+        sController.mParentRequestPending = false;
+        otCliOutputFormat("PREFPARENT event=parent_request_started generation=%lu\r\n",
+                          static_cast<unsigned long>(sController.mGeneration));
+    }
+
+    if (sController.mAttacherStatePending)
+    {
+        sController.mAttacherStatePending = false;
+        otCliOutputFormat("PREFPARENT event=attacher_state generation=%lu state=%u\r\n",
+                          static_cast<unsigned long>(sController.mGeneration), sController.mAttacherState);
+    }
+
+    if (sController.mTargetResponsePending && (sController.mState == kStateWaitingTargetResponse))
+    {
+        otError error;
+
+        sController.mTargetResponsePending = false;
+        otCliOutputFormat("PREFPARENT event=target_response generation=%lu target=",
+                          static_cast<unsigned long>(sController.mGeneration));
+        OutputTarget();
+        otCliOutputFormat(" rloc16=%04x rssi=%d\r\n", sController.mTargetRloc16, sController.mTargetRssi);
+
+        error = thread_preferred_parent_ot_continue_selected_parent_attach(sController.mInstance, &sController.mTarget);
+        if (error != OT_ERROR_NONE)
+        {
+            FailOperation("continue_failed", error);
+            return;
+        }
+
+        sController.mState = kStateWaitingChildIdResponse;
+        otCliOutputFormat("PREFPARENT event=child_id_request_started generation=%lu target=",
+                          static_cast<unsigned long>(sController.mGeneration));
+        OutputTarget();
+        otCliOutputFormat("\r\n");
+    }
+
+    if ((sController.mState == kStateWaitingChildIdResponse) &&
+        (otThreadGetParentInfo(sController.mInstance, &parentInfo) == OT_ERROR_NONE) &&
+        IsSameExtAddress(parentInfo.mExtAddress, sController.mTarget))
+    {
+        otCliOutputFormat("PREFPARENT event=succeeded generation=%lu parent=",
+                          static_cast<unsigned long>(sController.mGeneration));
+        OutputTarget();
+        otCliOutputFormat("\r\n");
+        thread_preferred_parent_ot_clear(sController.mInstance);
+        sController.mState = kStateSucceeded;
+    }
+
+    if (((sController.mState == kStateWaitingTargetResponse) ||
+         (sController.mState == kStateWaitingChildIdResponse)) &&
+        (static_cast<uint32_t>(otPlatAlarmMilliGetNow() - sController.mStartedAt) >= kOperationTimeout))
+    {
+        FailOperation("timeout", OT_ERROR_RESPONSE_TIMEOUT);
+    }
+}
